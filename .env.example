# Port Server Backend
PORT=3000

# Groq Cloud AI API Key (Rekomendasi Gratis 14.400 request/hari: https://console.groq.com/keys)
GROQ_API_KEY=

# Google Gemini AI API Key (Dapatkan gratis di https://aistudio.google.com)
GEMINI_API_KEY=

# Model AI (Default: llama-3.3-70b-versatile atau llama-3.1-8b-instant)
AI_MODEL_NAME=llama-3.3-70b-versatile

# Auto Reply Bot AI WhatsApp (true / false)
AI_AUTO_REPLY=false

# Firebase Firestore & Auth Configuration (Wajib untuk login & penyimpanan data)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

